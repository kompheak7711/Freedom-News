# Postgres connection string (e.g. from Neon). Optional for local dev: without it,
# the pipeline runs in memory and nothing is kept between restarts.
DATABASE_URL=
# Needed for AI summaries (English + Khmer, plus the story category). Without it,
# summaries fall back to article text and are English only.
ANTHROPIC_API_KEY=
# Protects /api/cron/refresh. Any long random string.
CRON_SECRET=
# Optional: model used for summaries (default claude-opus-5-5; claude-haiku-5-5 is much cheaper)
SUMMARY_MODEL=
# Optional: stories summarized by Claude per refresh (default 30)
MAX_STORIES=
# Optional: stories kept in the feed snapshot; the rest get extractive summaries (default 80)
MAX_FEED_STORIES=
# Optional: public site URL for canonical and hreflang links (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=
# Set to 1 to use fixtures/demo-articles.json instead of live RSS feeds
NEWS_DEMO=
