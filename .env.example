# Needed for AI summaries. Without it, summaries fall back to article text.
ANTHROPIC_API_KEY=
# Optional: model used for summaries (default claude-opus-5-5; claude-haiku-5-5 is much cheaper)
SUMMARY_MODEL=
# Optional: stories summarized per refresh (default 30)
MAX_STORIES=
# Set to 1 to use fixtures/demo-articles.json instead of live RSS feeds
NEWS_DEMO=
